datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum QuestionType {
  TEXT
  CHOICE_SINGLE
  CHOICE_MULTI
  BOOLEAN
  DATE
  NUMBER
}

enum ResponseMode {
  ALL_AT_ONCE
  STEP_BY_STEP
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  forms     Form[]
  exportJobs ExportJob[]
  createdAt DateTime    @default(now())
}

model Form {
  id          String      @id @default(uuid())
  title       String
  description String?
  user        User        @relation(fields: [userId], references: [id])
  userId      String

  questions   Question[]
  responses   Response[]
  exportJobs  ExportJob[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())

  isPublished Boolean     @default(false)
  shareId     String      @unique @default(uuid())

  responseMode ResponseMode @default(ALL_AT_ONCE)
}

model Question {
  id          String   @id @default(uuid())
  text        String
  description String?
  type        QuestionType
  required    Boolean  @default(false)

  options     Json?
  config       Json?
  condition   Json?

  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  order       Int
}

model Response {
  id        String   @id @default(uuid())

  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String

  answers   Json
  // Питання, які фактично були показані користувачу під час проходження
  // (обчислюється сервером на основі condition кожного питання й наданих
  // відповідей — не покладаємось на клієнта, щоб не можна було підробити
  // приховані відповіді). Використовується аналітикою для розрізнення
  // "приховано умовою" vs "показано, але пропущено".
  visibleQuestionIds Json?

  createdAt DateTime @default(now())
}

enum ExportFormat {
  CSV
  EXCEL
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id          String       @id @default(uuid())

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String

  user        User         @relation(fields: [userId], references: [id])
  userId      String

  format      ExportFormat
  status      ExportStatus @default(PENDING)

  filePath    String?
  fileName    String?

  responseCount Int?

  error       String?

  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([formId])
  @@index([userId])
}
